# Secrets and machine-specific config
.env
scripts/deploy.config.ps1

# Local data: the dev database, covers, backups, and anything imported
devdata/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Build output. web/dist is built before any Go command.
/dist/
web/dist/
web/node_modules/
# The end-to-end tests' signed-in session, their server's log and their reports
web/e2e/.state.json
web/e2e/.server.log
web/test-results/
web/playwright-report/
# The front end's coverage report (npm run test:coverage)
web/coverage/

# Tool caches
.task/
