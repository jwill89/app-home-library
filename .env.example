# Copy to .env for local development. .env is git-ignored and the Taskfile loads it.
# On the droplet these live in /etc/homelibrary/homelibrary.env (root-owned, 0600).

# Listen address. The droplet binds to localhost behind Apache.
HL_ADDR=127.0.0.1:8130

# debug, info, warn, or error
HL_LOG_LEVEL=info

# Every public origin the site answers on, comma-separated. Each gets its own cookies and
# passkeys. Locally this is the Vite dev server, which proxies /api, /auth, /media, and the
# share links under /s.
HL_ORIGINS=http://localhost:5173

# Storage. Relative paths resolve from the working directory.
HL_DB_PATH=devdata/homelibrary.sqlite
HL_MEDIA_DIR=devdata/media
# Documents' files, private and served only through the API, beside the media directory
# unless set: HL_DOCS_DIR=devdata/documents

# Google Books API key, restricted to the Books API (and, on the droplet, its address).
# Empty runs without Google: Library of Congress and Open Library still answer.
HL_GOOGLE_BOOKS_KEY=

# Hardcover API token (hardcover.app, Settings, API), for covers and series the other sources
# lack. Empty runs without Hardcover.
HL_HARDCOVER_TOKEN=

# `homelibrary backup`: where the daily snapshots (database, covers, documents) land and how
# many days are kept.
HL_BACKUP_DIR=devdata/backups
HL_BACKUP_KEEP=28
