{
  "name": "home-library-web",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\" && node scripts/check-tokens.mjs",
    "format": "prettier --write src e2e/*.ts playwright.config.ts",
    "format:check": "prettier --check src e2e/*.ts playwright.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:all": "npm audit --omit=dev --audit-level=low && npm audit --audit-level=high"
  },
  "dependencies": {
    "@awesome.me/kit-4f2bd9b614": "^1.0.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@primeuix/themes": "^1.2.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "barcode-detector": "^3.2.3",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "primevue": "^4.5.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@jwill89/lint-web": "file:../shared/lint/web",
    "@jwill89/test-a11y": "file:../shared/test/a11y",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.10.0",
    "stylelint": "18.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "^5.0.3",
    "vue-tsc": "3.3.13"
  }
}
