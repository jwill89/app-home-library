{
  "name": "home-library-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.{css,vue}\" && node scripts/check-tokens.mjs",
    "format": "prettier --write src e2e/*.ts playwright.config.ts",
    "format:check": "prettier --check src e2e/*.ts playwright.config.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/pro-regular-svg-icons": "^7.0.0",
    "@fortawesome/pro-solid-svg-icons": "^7.0.0",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@primeuix/themes": "^1.2.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "barcode-detector": "^3.2.3",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "primevue": "^4.5.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "happy-dom": "^21.0.4",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.3",
    "vue-tsc": "3.3.13"
  }
}
