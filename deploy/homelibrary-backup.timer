# Installed at /etc/systemd/system/homelibrary-backup.timer by every deploy; see docs/ops.md.
# Every morning at 09:30 UTC (3:30 or 4:30 in the morning in Central time), when nobody is
# adding books, and half an hour before Kindred Nights' own backup on the same droplet.
# A missed morning runs at the next boot.

[Unit]
Description=Home Library nightly backup

[Timer]
OnCalendar=*-*-* 09:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
