# Installed at /etc/systemd/system/homelibrary-backup.service, with its timer, by every
# deploy (scripts/deploy.ps1); see docs/ops.md.

[Unit]
Description=Home Library nightly backup

[Service]
Type=oneshot
User=homelibrary
Group=homelibrary
WorkingDirectory=/opt/homelibrary
EnvironmentFile=-/etc/homelibrary/homelibrary.env
ExecStart=/opt/homelibrary/homelibrary backup
Nice=10
TimeoutStartSec=30min

# The same hardening as the service. One writable path over both the data and the backups,
# not one each: each would be its own mount, and a hard link cannot cross mounts. The binary
# beside them is root's, so it stays out of reach all the same.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/homelibrary
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelibrary-backup
